# Public origin (used in emails, the bookmarklet and absolute links)
BASE_URL=https://wishlist.serika.dev

# Postgres — the schema creates itself on first query
DATABASE_URL=postgres://serikawishlist:password@host:5432/serikawishlist

# serika-accounts — same internal key as SerikaIssues / SerikaCord
ACCOUNTS_URL=https://accounts.serika.dev
AUTH_INTERNAL_KEY=

# Amazon SES (same account as serika.moe)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_EMAIL_DOMAIN=serika.email
# EMAIL_FROM=Serika Wishlist <wishlist@serika.email>

# Signs magic links. Any long random string.
APP_SECRET=

PORT=3710

# Backblaze B2 (S3 API) — serika-accounts' bucket; uploads go under wishlist/
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
